<div class="mb-8">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-gray-500"><%= t(".subtitle") %></p>
</div>

<div class="space-y-4">
  <% @service_categories.each do |category| %>
    <% queue = @queues_by_category[category.id] %>
    <div id="<%= dom_id(category) %>" class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-sm font-semibold text-gray-900"><%= category.name %></h2>
          <p class="mt-1 text-xs text-gray-500">
            <% if queue %>
              <%= t(".entries_count", count: queue.queue_entries.active.count) %>
            <% else %>
              <%= t(".not_open") %>
            <% end %>
          </p>
        </div>
        <div class="flex items-center gap-3">
          <% if queue %>
            <%= queue_status_badge(queue.status) %>
            <%= link_to t(".view"),
                  workshop_management_workshop_queue_path(@workshop, queue),
                  class: "text-sm font-medium text-gray-500 hover:text-black transition-colors" %>
          <% else %>
            <%= button_to t(".open_queue"),
                  open_workshop_management_workshop_queues_path(@workshop, service_category_id: category.id),
                  method: :patch,
                  class: "btn-primary cursor-pointer text-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# General (category-less) queue %>
  <% general = @queues_by_category[nil] %>
  <div id="general_queue_row" class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-semibold text-gray-900"><%= t(".general_queue") %></h2>
        <p class="mt-1 text-xs text-gray-500">
          <% if general %>
            <%= t(".entries_count", count: general.queue_entries.active.count) %>
          <% else %>
            <%= t(".not_open") %>
          <% end %>
        </p>
      </div>
      <div class="flex items-center gap-3">
        <% if general %>
          <%= queue_status_badge(general.status) %>
          <%= link_to t(".view"),
                workshop_management_workshop_queue_path(@workshop, general),
                class: "text-sm font-medium text-gray-500 hover:text-black transition-colors" %>
        <% else %>
          <%= button_to t(".open_queue"),
                open_workshop_management_workshop_queues_path(@workshop),
                method: :patch,
                class: "btn-primary cursor-pointer text-sm" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
