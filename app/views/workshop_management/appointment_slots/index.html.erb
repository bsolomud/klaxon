<div class="mb-8">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-gray-500"><%= t(".subtitle") %></p>
</div>

<div class="mb-6 flex flex-wrap items-center gap-4">
  <%= link_to t(".prev_day"), workshop_management_workshop_appointment_slots_path(@workshop, date: @date.prev_day),
        class: "text-sm text-gray-500 hover:text-black" %>
  <span class="text-sm font-medium text-gray-900"><%= l(@date, format: :long) %></span>
  <%= link_to t(".next_day"), workshop_management_workshop_appointment_slots_path(@workshop, date: @date.next_day),
        class: "text-sm text-gray-500 hover:text-black" %>
</div>

<% if @categories.any? %>
  <div class="mb-8 rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wider text-gray-900"><%= t(".generate_title") %></h2>
    <%= form_with url: generate_workshop_management_workshop_appointment_slots_path(@workshop), method: :post,
          class: "flex flex-wrap items-end gap-3" do %>
      <%= hidden_field_tag :date, @date.iso8601 %>
      <div>
        <label class="label-input" for="workshop_service_category_id"><%= t(".service") %></label>
        <%= select_tag :workshop_service_category_id,
              options_for_select(@categories.map { |wsc| [wsc.service_category.name, wsc.id] }),
              class: "mt-1 block rounded-lg border-gray-300 text-sm focus:border-black focus:ring-black" %>
      </div>
      <%= submit_tag t(".generate_button"), class: "btn-primary !w-auto cursor-pointer" %>
    <% end %>
  </div>
<% end %>

<div class="mb-8 rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
  <h2 class="mb-1 text-sm font-medium uppercase tracking-wider text-gray-900"><%= t(".closures_title") %></h2>
  <p class="mb-3 text-xs text-gray-500"><%= t(".closures_hint") %></p>
  <%= form_with url: workshop_management_workshop_working_hour_exceptions_path(@workshop), method: :post,
        class: "flex flex-wrap items-end gap-3" do %>
    <%= date_field_tag :date, @date.iso8601, class: "rounded-lg border-gray-300 text-sm focus:border-black focus:ring-black" %>
    <%= submit_tag t(".add_closure"), class: "btn-primary !w-auto cursor-pointer" %>
  <% end %>
  <% if @closures.any? %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% @closures.each do |closure| %>
        <span class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-700">
          <%= l(closure.date) %>
          <%= button_to "×", workshop_management_workshop_working_hour_exception_path(@workshop, closure), method: :delete,
                class: "leading-none text-gray-400 hover:text-red-600 cursor-pointer" %>
        </span>
      <% end %>
    </div>
  <% end %>
</div>

<% if @slots.any? %>
  <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wider text-gray-400">
          <th class="px-4 py-2"><%= t(".time") %></th>
          <th class="px-4 py-2"><%= t(".service") %></th>
          <th class="px-4 py-2 text-right"><%= t(".booked") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% @slots.each do |slot| %>
          <tr>
            <td class="px-4 py-2.5 text-gray-900"><%= l(slot.starts_at, format: :short) %></td>
            <td class="px-4 py-2.5 text-gray-600"><%= slot.workshop_service_category.service_category.name %></td>
            <td class="px-4 py-2.5 text-right text-gray-500"><%= slot.booked_count %> / <%= slot.capacity %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-sm text-gray-400"><%= t(".empty") %></p>
<% end %>
