<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-gray-500"><%= t(".subtitle") %></p>
  </div>

  <% if user_signed_in? %>
    <%= link_to new_workshop_path,
          class: "inline-flex items-center gap-1.5 rounded-xl border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:border-black hover:text-black transition-colors" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.614 2.993 2.993 0 0 0 2.25 1.016 2.993 2.993 0 0 0 2.25-1.016 3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72" />
      </svg>
      <%= t(".list_business") %>
    <% end %>
  <% end %>
</div>

<%# Search + filters %>
<div class="mb-6">
  <%= form_with url: workshops_path, method: :get, class: "flex flex-wrap gap-2 items-center" do %>
    <% request.query_parameters.slice("near", "city", "country").each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>
    <%= text_field_tag :q, params[:q],
          placeholder: t(".search_placeholder"),
          class: "flex-1 min-w-[180px] rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:border-black focus:ring-1 focus:ring-black" %>
    <%= search_field_tag :location, params[:location],
          placeholder: t(".location_placeholder"),
          class: "flex-1 min-w-[180px] rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:border-black focus:ring-1 focus:ring-black" %>
    <%= select_tag :category,
          options_for_select([[t(".all_categories"), ""]] + @service_categories.map { |c| [c.name, c.slug] }, params[:category]),
          class: "rounded-xl border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-700 focus:border-black focus:ring-1 focus:ring-black" %>
    <%= select_tag :sort,
          options_for_select([[t(".sort_name"), "name"], [t(".sort_rating"), "rating"]], params[:sort]),
          class: "rounded-xl border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-700 focus:border-black focus:ring-1 focus:ring-black" %>
    <label class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-600 cursor-pointer">
      <%= check_box_tag :open_now, "1", params[:open_now].present?, class: "rounded border-gray-300" %>
      <%= t(".open_now_filter") %>
    </label>
    <%= submit_tag t(".search_button"), class: "btn-primary !w-auto" %>
  <% end %>
</div>

<%# Filters %>
<%
  filters = [
    { key: "q",        label: params[:q],       bg: "bg-blue-100",  text: "text-blue-700", icon_color: "text-blue-400 hover:text-blue-600" },
    { key: "city",     label: params[:city],    bg: "bg-gray-100",  text: "text-gray-700", icon_color: "text-gray-400 hover:text-gray-600" },
    { key: "country",  label: params[:country],  bg: "bg-gray-100",  text: "text-gray-700", icon_color: "text-gray-400 hover:text-gray-600" },
    { key: "category", label: params[:category], bg: "bg-gray-100",  text: "text-gray-700", icon_color: "text-gray-400 hover:text-gray-600" },
    { key: "open_now", label: t(".open_now_filter"), bg: "bg-green-100", text: "text-green-700", icon_color: "text-green-400 hover:text-green-600" }
  ].select { |f| params[f[:key]].present? }
%>
<% if filters.any? %>
  <div class="mb-6 flex items-center gap-2 flex-wrap">
    <span class="text-xs text-gray-400 uppercase tracking-wider"><%= t(".filters") %>:</span>
    <% filters.each do |filter| %>
      <span class="inline-flex items-center gap-1 rounded-full <%= filter[:bg] %> px-3 py-1 text-xs font-medium <%= filter[:text] %>">
        <%= filter[:label] %>
        <%= link_to workshops_path(request.query_parameters.except(filter[:key])), class: filter[:icon_color] do %>
          <%= heroicon("x-mark", class: "h-3 w-3") %>
        <% end %>
      </span>
    <% end %>
  </div>
<% end %>

<% if @location_not_found %>
  <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-2 text-sm text-amber-800">
    <%= t(".location_not_found", query: params[:location]) %>
  </div>
<% end %>

<%# Map + near-me %>
<% map_points = @workshops.select { |w| w.latitude && w.longitude }.map { |w| { lat: w.latitude.to_f, lng: w.longitude.to_f, name: w.name, url: workshop_path(w) } } %>
<div class="mb-6" data-controller="map"
     data-map-points-value="<%= map_points.to_json %>"
     data-map-here-label-value="<%= t(".you_are_here") %>"
     <% if @search_center %>
       data-map-center-value="<%= @search_center.to_json %>"
       data-map-lat-value="<%= @search_center.first %>"
       data-map-lng-value="<%= @search_center.last %>"
       data-map-zoom-value="13"
     <% end %>>
  <div data-map-target="canvas" class="h-72 sm:h-80 rounded-2xl overflow-hidden border border-gray-100"></div>
  <div class="mt-2 flex justify-end">
    <button type="button" data-action="map#geolocate"
            class="inline-flex items-center gap-1.5 text-sm text-gray-600 hover:text-black cursor-pointer">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
      </svg>
      <%= t(".near_me") %>
    </button>
  </div>
  <p data-map-target="error" class="hidden mt-2 text-right text-xs text-amber-700"><%= t(".geo_error") %></p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <%= render partial: "workshops/workshop_card", collection: @workshops, as: :workshop %>
</div>

<% if @workshops.empty? %>
  <div class="text-center py-12">
    <p class="text-sm text-gray-500"><%= t(".empty") %></p>
  </div>
<% end %>

<%= render "shared/pagy_nav", pagy: @pagy %>
